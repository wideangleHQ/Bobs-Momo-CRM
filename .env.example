# Copy to apps/api/.env and fill in. Never commit the filled copy.

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
TZ=Asia/Kolkata

# Local docker compose. In staging/prod DATABASE_URL is the Supabase Session
# Pooler (aws-0-ap-southeast-1.pooler.supabase.com:5432) and DIRECT_URL is the
# direct DB host — needed by prisma migrate and the advisory-lock service,
# never by the app's main Prisma client.
# e.g. DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
# Connection budget. The Session Pooler allows 15 clients for the whole project,
# shared by every process pointed at it: this laptop, each Railway replica,
# prisma migrate and Prisma Studio. Prisma's own default pool is 2 x CPU + 1
# (25 on a 12 core machine), so the API now sizes it explicitly:
#   DB_POOL_SIZE  main client; unset = 5 in production/staging, 3 otherwise.
#   + 1           the job-lock client (always one connection, from DIRECT_URL).
# Local 3+1, Railway 5+1 = 10 of 15, leaving 5 for migrations and tools. A
# connection_limit written into DATABASE_URL itself wins over DB_POOL_SIZE.
# With more than one Railway replica, lower DB_POOL_SIZE so replicas x (pool + 1)
# plus the local 4 stays under 15. The Transaction Pooler (:6543, pgbouncer=true)
# measured ~4x slower per query from this app, so it is not the fix.
DATABASE_URL="postgresql://bobsmomo:localdev@localhost:54322/bobsmomo?schema=public"
DIRECT_URL="postgresql://bobsmomo:localdev@localhost:54322/bobsmomo?schema=public"

REDIS_URL="redis://localhost:63790"

# openssl rand -hex 32, twice. They must differ.
JWT_ACCESS_SECRET="replace-me-64-hex-characters-0000000000000000000000000000000000"
JWT_REFRESH_SECRET="replace-me-different-64-hex-chars-11111111111111111111111111111"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# Browser origins allowed to call the API, comma separated, scheme + host only. On the host
# (Railway) this MUST be the deployed frontend, e.g. "https://crm.bobsmomo.com"; the default
# below is localhost only, so an unset variable blocks every production login with a CORS error.
# Trailing slashes and quotes are stripped; "*" is refused.
CORS_ORIGINS="http://localhost:3000"

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="bobs-momo"

LOG_LEVEL=debug

# Pool wait: seconds a query waits for a free connection before the request fails
# with 503 COMMON_UNAVAILABLE and a Retry-After header.
# DB_POOL_SIZE=3
DB_POOL_TIMEOUT_S=20

# Requests and single SQL statements slower than these are logged as warnings.
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=300
