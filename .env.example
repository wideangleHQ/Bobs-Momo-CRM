# Copy to apps/api/.env and fill in. Never commit the filled copy.

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
TZ=Asia/Kolkata

# Local docker compose. In staging/prod DATABASE_URL is the Supabase Session
# Pooler (aws-0-ap-southeast-1.pooler.supabase.com:5432) and DIRECT_URL is the
# direct DB host — needed by prisma migrate and the advisory-lock service,
# never by the app's main Prisma client.
# e.g. DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?connection_limit=10"
# Keep connection_limit. The Session Pooler allows 15 clients per project and
# Prisma's default pool (2 x CPU cores + 1) exceeds that on most hosts; past 15
# requests fail with EMAXCONNSESSION. With more than one API instance, divide
# the 15 between them. The Transaction Pooler (:6543, pgbouncer=true) measured
# ~4x slower per query from this app, so it is not the fix.
DATABASE_URL="postgresql://bobsmomo:localdev@localhost:54322/bobsmomo?schema=public"
DIRECT_URL="postgresql://bobsmomo:localdev@localhost:54322/bobsmomo?schema=public"

REDIS_URL="redis://localhost:63790"

# openssl rand -hex 32, twice. They must differ.
JWT_ACCESS_SECRET="replace-me-64-hex-characters-0000000000000000000000000000000000"
JWT_REFRESH_SECRET="replace-me-different-64-hex-chars-11111111111111111111111111111"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS="http://localhost:3000"

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="bobs-momo"

LOG_LEVEL=debug

# Requests and single SQL statements slower than these are logged as warnings.
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=300
