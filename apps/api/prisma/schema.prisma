generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres.dtrpmwudupitmcvjiidk:Bobsmomo%4002@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
}

model Outlet {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique
  name         String
  address      String?
  timezone     String             @default("Asia/Kolkata")
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  salesEntries DailySalesEntry[]
  departments  Department[]
  employees    Employee[]
  itemStocks   ItemStock[]
  purchases    Purchase[]
  purchaseReqs PurchaseRequest[]
  shifts       Shift[]
  stockTxns    StockTransaction[]
  tasks        Task[]
  userOutlets  UserOutlet[]
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  outletId  String     @db.Uuid
  name      String
  isActive  Boolean    @default(true)
  outlet    Outlet     @relation(fields: [outletId], references: [id])
  employees Employee[]

  @@unique([outletId, name])
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String?        @unique
  username      String         @unique
  passwordHash  String
  status        UserStatus     @default(ACTIVE)
  roleKey       RoleKey
  mustReset     Boolean        @default(true)
  failedLogins  Int            @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  employee      Employee?
  notifications Notification[]
  refreshTokens RefreshToken[]
  outlets       UserOutlet[]

  @@index([roleKey, status])
}

model UserOutlet {
  userId   String @db.Uuid
  outletId String @db.Uuid
  outlet   Outlet @relation(fields: [outletId], references: [id])
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, outletId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Employee {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String?          @unique @db.Uuid
  employeeCode String           @unique
  fullName     String
  phone        String
  outletId     String           @db.Uuid
  departmentId String?          @db.Uuid
  designation  String?
  joinedOn     DateTime         @db.Date
  exitedOn     DateTime?        @db.Date
  status       EmploymentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  attendance   AttendanceDay[]
  department   Department?      @relation(fields: [departmentId], references: [id])
  outlet       Outlet           @relation(fields: [outletId], references: [id])
  user         User?            @relation(fields: [userId], references: [id])
  leaves       LeaveRequest[]
  salary       SalaryRecord[]
  shifts       Shift[]
  tasks        Task[]           @relation("TaskAssignee")
  createdTask  Task[]           @relation("TaskCreator")

  @@index([outletId, status])
}

model Unit {
  id    String          @id @default(uuid()) @db.Uuid
  code  String          @unique
  name  String
  items InventoryItem[]
}

model ItemCategory {
  id    String          @id @default(uuid()) @db.Uuid
  name  String          @unique
  items InventoryItem[]
}

model InventoryItem {
  id            String                @id @default(uuid()) @db.Uuid
  sku           String                @unique
  name          String
  categoryId    String                @db.Uuid
  unitId        String                @db.Uuid
  isPerishable  Boolean               @default(false)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  category      ItemCategory          @relation(fields: [categoryId], references: [id])
  unit          Unit                  @relation(fields: [unitId], references: [id])
  priceHistory  ItemPriceHistory[]
  stocks        ItemStock[]
  purchaseLines PurchaseItem[]
  requestLines  PurchaseRequestLine[]
  transactions  StockTransaction[]
  vendorLinks   VendorItem[]

  @@index([categoryId, isActive])
}

model ItemStock {
  id           String        @id @default(uuid()) @db.Uuid
  itemId       String        @db.Uuid
  outletId     String        @db.Uuid
  qtyOnHand    Decimal       @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal?      @db.Decimal(14, 3)
  lastAlertAt  DateTime?
  updatedAt    DateTime      @updatedAt
  item         InventoryItem @relation(fields: [itemId], references: [id])
  outlet       Outlet        @relation(fields: [outletId], references: [id])

  @@unique([itemId, outletId])
  @@index([outletId])
}

model StockTransaction {
  id             String        @id @default(uuid()) @db.Uuid
  itemId         String        @db.Uuid
  outletId       String        @db.Uuid
  type           StockTxnType
  quantity       Decimal       @db.Decimal(14, 3)
  signedQty      Decimal       @db.Decimal(14, 3)
  balanceAfter   Decimal       @db.Decimal(14, 3)
  businessDate   DateTime      @db.Date
  reason         String?
  note           String?
  sourceType     String?
  sourceId       String?       @db.Uuid
  transferPairId String?       @db.Uuid
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  item           InventoryItem @relation(fields: [itemId], references: [id])
  outlet         Outlet        @relation(fields: [outletId], references: [id])

  @@index([outletId, businessDate])
  @@index([itemId, outletId, createdAt])
}

model Vendor {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique
  phone        String?
  email        String?
  address      String?
  gstin        String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  priceHistory ItemPriceHistory[]
  purchases    Purchase[]
  items        VendorItem[]
}

model VendorItem {
  vendorId String        @db.Uuid
  itemId   String        @db.Uuid
  item     InventoryItem @relation(fields: [itemId], references: [id])
  vendor   Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([vendorId, itemId])
}

model PurchaseRequest {
  id            String                @id @default(uuid()) @db.Uuid
  requestNo     String                @unique
  outletId      String                @db.Uuid
  status        PurchaseRequestStatus @default(PENDING)
  neededBy      DateTime?             @db.Date
  note          String?
  requestedById String                @db.Uuid
  decidedById   String?               @db.Uuid
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  outlet        Outlet                @relation(fields: [outletId], references: [id])
  lines         PurchaseRequestLine[]

  @@index([outletId, status])
}

model PurchaseRequestLine {
  id        String          @id @default(uuid()) @db.Uuid
  requestId String          @db.Uuid
  itemId    String          @db.Uuid
  quantity  Decimal         @db.Decimal(14, 3)
  note      String?
  item      InventoryItem   @relation(fields: [itemId], references: [id])
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Purchase {
  id           String         @id @default(uuid()) @db.Uuid
  purchaseNo   String         @unique
  outletId     String         @db.Uuid
  vendorId     String         @db.Uuid
  requestId    String?        @db.Uuid
  status       PurchaseStatus @default(DRAFT)
  invoiceNo    String?
  purchaseDate DateTime       @db.Date
  subtotal     Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount    Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount  Decimal        @default(0) @db.Decimal(14, 2)
  recordedById String         @db.Uuid
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  outlet       Outlet         @relation(fields: [outletId], references: [id])
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  items        PurchaseItem[]

  @@index([outletId, purchaseDate])
  @@index([vendorId, purchaseDate])
}

model PurchaseItem {
  id         String        @id @default(uuid()) @db.Uuid
  purchaseId String        @db.Uuid
  itemId     String        @db.Uuid
  quantity   Decimal       @db.Decimal(14, 3)
  unitPrice  Decimal       @db.Decimal(14, 2)
  lineTotal  Decimal       @db.Decimal(14, 2)
  item       InventoryItem @relation(fields: [itemId], references: [id])
  purchase   Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model ItemPriceHistory {
  id         String        @id @default(uuid()) @db.Uuid
  itemId     String        @db.Uuid
  vendorId   String        @db.Uuid
  unitPrice  Decimal       @db.Decimal(14, 2)
  observedOn DateTime      @db.Date
  purchaseId String?       @db.Uuid
  createdAt  DateTime      @default(now())
  item       InventoryItem @relation(fields: [itemId], references: [id])
  vendor     Vendor        @relation(fields: [vendorId], references: [id])

  @@index([itemId, observedOn])
}

model Shift {
  id          String      @id @default(uuid()) @db.Uuid
  employeeId  String      @db.Uuid
  outletId    String      @db.Uuid
  shiftDate   DateTime    @db.Date
  startsAt    DateTime
  endsAt      DateTime
  status      ShiftStatus @default(SCHEDULED)
  note        String?
  createdById String      @db.Uuid
  createdAt   DateTime    @default(now())
  employee    Employee    @relation(fields: [employeeId], references: [id])
  outlet      Outlet      @relation(fields: [outletId], references: [id])

  @@unique([employeeId, shiftDate, startsAt])
  @@index([outletId, shiftDate])
}

model AttendanceDay {
  id           String            @id @default(uuid()) @db.Uuid
  employeeId   String            @db.Uuid
  outletId     String            @db.Uuid
  businessDate DateTime          @db.Date
  status       AttendanceStatus  @default(ABSENT)
  firstInAt    DateTime?
  lastOutAt    DateTime?
  workedMins   Int               @default(0)
  breakMins    Int               @default(0)
  lateMins     Int               @default(0)
  note         String?
  updatedAt    DateTime          @updatedAt
  employee     Employee          @relation(fields: [employeeId], references: [id])
  punches      AttendancePunch[]
  breaks       BreakLog[]

  @@unique([employeeId, businessDate])
  @@index([outletId, businessDate])
}

model AttendancePunch {
  id              String        @id @default(uuid()) @db.Uuid
  attendanceDayId String        @db.Uuid
  direction       String
  punchedAt       DateTime
  source          String        @default("WEB")
  editedById      String?       @db.Uuid
  editReason      String?
  createdAt       DateTime      @default(now())
  day             AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  @@index([attendanceDayId, punchedAt])
}

model BreakLog {
  id              String        @id @default(uuid()) @db.Uuid
  attendanceDayId String        @db.Uuid
  startedAt       DateTime
  endedAt         DateTime?
  durationMins    Int?
  reason          String?
  day             AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  @@index([attendanceDayId])
}

model LeaveRequest {
  id           String      @id @default(uuid()) @db.Uuid
  employeeId   String      @db.Uuid
  type         LeaveType
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  dayCount     Decimal     @db.Decimal(4, 1)
  reason       String
  status       LeaveStatus @default(PENDING)
  decidedById  String?     @db.Uuid
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  employee     Employee    @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([status, fromDate])
}

model SalaryRecord {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  monthlyCtc    Decimal   @db.Decimal(12, 2)
  basic         Decimal?  @db.Decimal(12, 2)
  allowances    Decimal?  @db.Decimal(12, 2)
  note          String?
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
}

model ChecklistTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  code        String                  @unique
  name        String
  description String?
  isAudit     Boolean                 @default(false)
  outletId    String?                 @db.Uuid
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  items       ChecklistTemplateItem[]
  tasks       Task[]
  recurrence  TaskRecurrence[]
}

model ChecklistTemplateItem {
  id              String            @id @default(uuid()) @db.Uuid
  templateId      String            @db.Uuid
  sortOrder       Int
  label           String
  requiresPhoto   Boolean           @default(false)
  requiresNote    Boolean           @default(false)
  failCreatesTask Boolean           @default(false)
  isActive        Boolean           @default(true)
  template        ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sortOrder])
}

model TaskRecurrence {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  cronExpr     String
  templateId   String?            @db.Uuid
  title        String?
  outletId     String?            @db.Uuid
  departmentId String?            @db.Uuid
  assigneeId   String?            @db.Uuid
  priority     TaskPriority       @default(NORMAL)
  dueAfterMins Int                @default(120)
  isActive     Boolean            @default(true)
  lastRunAt    DateTime?
  createdAt    DateTime           @default(now())
  tasks        Task[]
  template     ChecklistTemplate? @relation(fields: [templateId], references: [id])
}

model Task {
  id                   String                @id @default(uuid()) @db.Uuid
  kind                 TaskKind
  title                String
  description          String?
  outletId             String                @db.Uuid
  departmentId         String?               @db.Uuid
  assigneeId           String?               @db.Uuid
  createdById          String                @db.Uuid
  templateId           String?               @db.Uuid
  recurrenceId         String?               @db.Uuid
  parentTaskId         String?               @db.Uuid
  priority             TaskPriority          @default(NORMAL)
  status               TaskStatus            @default(OPEN)
  dueAt                DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  verifiedAt           DateTime?
  verifiedById         String?               @db.Uuid
  requiresVerification Boolean               @default(false)
  overdueNotifiedAt    DateTime?
  businessDate         DateTime              @db.Date
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  assignee             Employee?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator              Employee              @relation("TaskCreator", fields: [createdById], references: [id])
  outlet               Outlet                @relation(fields: [outletId], references: [id])
  recurrence           TaskRecurrence?       @relation(fields: [recurrenceId], references: [id])
  template             ChecklistTemplate?    @relation(fields: [templateId], references: [id])
  attachments          TaskAttachment[]
  results              TaskChecklistResult[]
  comments             TaskComment[]

  @@unique([recurrenceId, outletId, businessDate], name: "task_recurrence_day_uniq")
  @@index([outletId, status, dueAt])
  @@index([assigneeId, status])
  @@index([status, dueAt])
}

model TaskChecklistResult {
  id             String              @id @default(uuid()) @db.Uuid
  taskId         String              @db.Uuid
  templateItemId String              @db.Uuid
  result         ChecklistItemResult
  note           String?
  attachmentId   String?             @db.Uuid
  recordedAt     DateTime            @default(now())
  task           Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, templateItemId])
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model DailySalesEntry {
  id           String    @id @default(uuid()) @db.Uuid
  outletId     String    @db.Uuid
  businessDate DateTime  @db.Date
  grossSales   Decimal   @db.Decimal(14, 2)
  discounts    Decimal   @default(0) @db.Decimal(14, 2)
  netSales     Decimal   @db.Decimal(14, 2)
  orderCount   Int?
  cashAmount   Decimal   @default(0) @db.Decimal(14, 2)
  upiAmount    Decimal   @default(0) @db.Decimal(14, 2)
  cardAmount   Decimal   @default(0) @db.Decimal(14, 2)
  otherAmount  Decimal   @default(0) @db.Decimal(14, 2)
  note         String?
  enteredById  String    @db.Uuid
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  outlet       Outlet    @relation(fields: [outletId], references: [id])

  @@unique([outletId, businessDate])
  @@index([businessDate])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventKey      String
  aggregateType String
  aggregateId   String       @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  eventKey    String
  channel     NotificationChannel
  status      NotificationStatus  @default(QUEUED)
  title       String
  body        String
  deepLink    String?
  payload     Json?
  providerRef String?
  failReason  String?
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([status, channel])
}

model NotificationPreference {
  id       String              @id @default(uuid()) @db.Uuid
  userId   String              @db.Uuid
  eventKey String
  channel  NotificationChannel
  enabled  Boolean             @default(true)

  @@unique([userId, eventKey, channel])
}

model Message {
  id           String        @id @default(uuid()) @db.Uuid
  scope        MessageScope
  senderId     String        @db.Uuid
  recipientId  String?       @db.Uuid
  outletId     String?       @db.Uuid
  departmentId String?       @db.Uuid
  body         String
  isPinned     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  reads        MessageRead[]

  @@index([scope, outletId, createdAt])
  @@index([recipientId, createdAt])
}

model MessageRead {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model Customer {
  id          String        @id @default(uuid()) @db.Uuid
  phone       String        @unique
  name        String?
  isGuest     Boolean       @default(false)
  coinBalance Int           @default(0)
  consentAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  gamePlays   GamePlay[]
  rewards     RewardIssue[]
}

model GameConfig {
  id          String             @id @default(uuid()) @db.Uuid
  slug        String             @unique
  name        String
  rulesJson   Json
  isPublished Boolean            @default(false)
  publishedAt DateTime?
  version     Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  plays       GamePlay[]
  rewards     RewardDefinition[]
}

model GamePlay {
  id          String     @id @default(uuid()) @db.Uuid
  gameId      String     @db.Uuid
  customerId  String?    @db.Uuid
  sessionKey  String
  score       Int
  coinsEarned Int        @default(0)
  ipHash      String?
  playedAt    DateTime   @default(now())
  customer    Customer?  @relation(fields: [customerId], references: [id])
  game        GameConfig @relation(fields: [gameId], references: [id])

  @@index([gameId, playedAt])
  @@index([customerId, playedAt])
}

model RewardDefinition {
  id          String        @id @default(uuid()) @db.Uuid
  gameId      String?       @db.Uuid
  code        String        @unique
  name        String
  coinCost    Int
  description String?
  isActive    Boolean       @default(true)
  game        GameConfig?   @relation(fields: [gameId], references: [id])
  issues      RewardIssue[]
}

model RewardIssue {
  id               String           @id @default(uuid()) @db.Uuid
  customerId       String           @db.Uuid
  definitionId     String           @db.Uuid
  couponCode       String           @unique
  status           RewardStatus     @default(ISSUED)
  expiresAt        DateTime?
  redeemedAt       DateTime?
  redeemedOutletId String?          @db.Uuid
  redeemedById     String?          @db.Uuid
  createdAt        DateTime         @default(now())
  customer         Customer         @relation(fields: [customerId], references: [id])
  definition       RewardDefinition @relation(fields: [definitionId], references: [id])

  @@index([customerId, status])
}

model DocumentCounter {
  kind      String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([kind, year])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorLabel String
  action     String
  entityType String
  entityId   String?  @db.Uuid
  outletId   String?  @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([outletId, createdAt])
  @@index([actorId, createdAt])
}

enum RoleKey {
  OWNER
  OPERATIONS_MANAGER
  STORE_MANAGER
  KITCHEN_MANAGER
  INVENTORY_MANAGER
  PURCHASE_MANAGER
  HR_ACCOUNTS
  KITCHEN_STAFF
  COUNTER_CASHIER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum EmploymentStatus {
  ACTIVE
  ON_NOTICE
  EXITED
}

enum StockTxnType {
  OPENING
  RECEIVED
  ISSUED
  WASTAGE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  CLOSING
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  FULFILLED
}

enum PurchaseStatus {
  DRAFT
  RECORDED
  VOIDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
}

enum ShiftStatus {
  SCHEDULED
  SWAPPED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  UNPAID
  COMP_OFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskKind {
  ONE_OFF
  RECURRING_INSTANCE
  CHECKLIST_RUN
  AUDIT_RUN
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
  OVERDUE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ChecklistItemResult {
  PASS
  FAIL
  NA
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

enum OutboxStatus {
  PENDING
